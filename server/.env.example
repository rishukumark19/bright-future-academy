# ══════════════════════════════════════════════════
# COURSE PLATFORM — ENVIRONMENT VARIABLES
# Copy this to .env and fill in all values
# NEVER commit .env to git
# ══════════════════════════════════════════════════

# ── SERVER ──────────────────────────────────────
NODE_ENV=development
PORT=3000
FRONTEND_URL=https://bright-future-academy-production.up.railway.app

# ── RAZORPAY ─────────────────────────────────────
# Get from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
# Get from: https://dashboard.razorpay.com/app/webhooks
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxx

# Course price in paise (₹1 = 100 paise)
# ₹499 = 49900 paise
COURSE_PRICE_PAISE=49900

# ── SUPABASE ──────────────────────────────────────
# Get from: https://supabase.com/dashboard/project/[your-project]/settings/api
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...  # Service Role key (NOT the anon key)

# ── GOOGLE DRIVE ─────────────────────────────────
# From: Google Cloud Console → IAM → Service Accounts → Keys → JSON
GOOGLE_SERVICE_ACCOUNT_EMAIL=course-bot@your-project.iam.gserviceaccount.com
# Paste the private key from your JSON key file
# Keep the -----BEGIN... and -----END... lines, use \n for newlines
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEoAIBAAKCAQEA...\n-----END RSA PRIVATE KEY-----\n"

# From the URL: drive.google.com/drive/folders/THIS_PART
GOOGLE_DRIVE_FOLDER_ID=1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_DRIVE_FOLDER_URL=https://drive.google.com/drive/folders/1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── EMAIL (RESEND) ────────────────────────────────
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=Bright Future Academy <support@brightfutureacademy.com>
ADMIN_EMAIL=support@brightfutureacademy.com

# ── COURSE DETAILS (used in emails) ──────────────
COURSE_NAME=Study Material & Practice Papers
BRAND_NAME=Bright Future Academy

# ── SUPPORT ───────────────────────────────────────
ADMIN_WHATSAPP=919876543210
